{
  "name": "@irl-commons/stream-status",
  "version": "0.1.0",
  "description": "Types, validation and a reader for live-stream problems: what is wrong, where, and whether the stream is still live.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "bin": {
    "stream-status": "./dist/src/cli.js"
  },
  "files": [
    "dist/src",
    "LICENSE"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "node --input-type=module -e \"import {rmSync} from 'node:fs'; rmSync('dist', {recursive:true, force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "conformance": "tsc -p tsconfig.json && node dist/conformance/run.js",
    "prepublishOnly": "npm test && npm run test:package",
    "test:package": "node scripts/test-package.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/irl-commons/stream-status.git",
    "directory": "packages/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "npm@11.20.0"
}
