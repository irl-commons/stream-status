{
  "name": "@openstreambox/stream-status",
  "version": "0.0.0",
  "private": true,
  "description": "Types, validator and reader for stream-status v0 snapshots",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "bin": {
    "stream-status": "./dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "conformance": "tsc -p tsconfig.json && node dist/conformance/run.js"
  },
  "devDependencies": {
    "@types/node": "22.20.4",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "6.0.3"
  }
}
